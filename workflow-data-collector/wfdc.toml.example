# Copy next to the wfdc binary as `wfdc.toml` and edit the URL.

# Office default host mapping is 6380. A standalone crew may be 6379.
redis_url = "redis://127.0.0.1:6380"

# Durable Office / crew event stream. Do not point this at pub/sub.
stream = "office:events"

# Dataset root. Created on first run. One collector per directory.
data_dir = "./wfdc-data"

# Hard cap on collected JSONL (raw + sessions, all teams).
# Oldest days are deleted first so the plugin cannot fill the factory disk.
# Default 500. Set higher (e.g. 1000) if Lab needs a longer window.
max_mb = 500
